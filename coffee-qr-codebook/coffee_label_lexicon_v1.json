  "dateRecognition": {
    "storageFormat": "YYYY-MM-DD",
    "principles": [
      "字段标签优先：烘焙日期、生产日期、包装日期、最佳赏味期和到期日必须分别保存，不得相互覆盖。",
      "YYYY-MM-DD和YYYYMMDD按年-月-日确定解析；纯数字YYMMDD仅在日期标签上下文中解析。",
      "当日和月均不大于12时，DD/MM/YY与MM/DD/YY必须保存两个候选并要求人工确认。",
      "保留rawValue、formatId、normalizedValue、candidates、confidence和warnings。",
      "没有日期标签时，不把批次、净重、价格、海拔或Agtron数字自动解释为日期。"
    ],
    "formats": [
      {"id":"ISO_EXTENDED","examples":["2026-07-27"],"order":"YMD","unambiguous":true},
      {"id":"ISO_BASIC","examples":["20260727"],"order":"YMD","unambiguous":true,"requiresDateContext":true},
      {"id":"YMD_SLASH","examples":["2026/07/27"],"order":"YMD","unambiguous":true},
      {"id":"YMD_DOT","examples":["2026.07.27"],"order":"YMD","unambiguous":true},
      {"id":"ZH_YMD","examples":["2026年7月27日","26年7月27日"],"order":"YMD","unambiguous":true},
      {"id":"DMY_TEXT","examples":["27 Jul 2026","27 July 2026"],"order":"DMY","unambiguous":true},
      {"id":"MDY_TEXT","examples":["Jul 27 2026","July 27, 2026"],"order":"MDY","unambiguous":true},
      {"id":"DMY_NUMERIC","examples":["27/07/2026","27-07-26"],"order":"DMY","unambiguousWhen":"firstNumber>12"},
      {"id":"MDY_NUMERIC","examples":["07/27/2026","07-27-26"],"order":"MDY","unambiguousWhen":"secondNumber>12"},
      {"id":"AMBIGUOUS_DMY_MDY","examples":["07/08/26","08-07-2026"],"order":"AMBIGUOUS","unambiguous":false},
      {"id":"GS1_YYMMDD","examples":["260727"],"order":"YMD","unambiguous":true,"requiresDateContext":true},
      {"id":"ISO_ORDINAL","examples":["2026-208","2026208"],"order":"YEAR_DAY_OF_YEAR","unambiguous":true},
      {"id":"SHORT_YEAR_ORDINAL","examples":["26-208","26.208"],"order":"YEAR_DAY_OF_YEAR","unambiguous":true,"requiresDateContext":true}
    ],
    "twoDigitYearPolicy": {"pivot":70,"00-69":"2000-2069","70-99":"1970-1999"}
  },
  "harvestRecognition": {
    "formats": [
      {"id":"HARVEST_YEAR","examples":["2026","26产季","Harvest 2026","Crop Year 2026"]},
      {"id":"HARVEST_RANGE","examples":["2025/26","2025-2026","Crop 2025/26","Harvest 25/26"]}
    ],
    "rules": ["产季是与采收开始月份相关的12个月区间，不等同于自然年。","区间形式保存harvestYear和harvestEndYear；不得把产季数字填入烘焙日期。","仅在产季／crop／harvest标签或明确字段附近捕捉两位年份。"]
  },
  "numericRecognition": {
    "roastColor": {"requiresLabel":true,"typicalAgtronGourmetRange":[20,100],"hardAcceptedRange":[0,150],"subtypes":["wholeBean","ground"],"rules":["Whole Bean Agtron和Ground Agtron分别保存，不得混为单一色值。","无Agtron／色值标签的两位或三位数字不得自动归类。","典型范围外保留原值但降低置信度并提示复核。"]},
    "altitude": {"requiresUnitOrLabel":true,"units":["m","meter","meters","metre","metres","MASL","m.a.s.l.","AMSL","ASL","ft","feet","ft ASL"],"rules":["范围形式如1800-2100 MASL保存最小值和最大值。","英尺可换算为米但必须保留原始单位和原始值。"]},
    "weight": {"requiresUnitOrLabel":true,"units":["g","gram","grams","kg","oz","ounce","ounces","lb","lbs"],"rules":["净重字段与豆子剩余克重不同；OCR导入时只初始化包装净重。"]}
