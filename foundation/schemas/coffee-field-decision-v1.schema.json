{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brewion:foundation:coffee-field-decision:1.0",
  "title": "Coffee Foundation Field Decision 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "field", "rawValue", "normalizedValue", "matchKey", "locale", "status", "reason", "selected", "candidates", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": "coffee-field-decision/1.0" },
    "field": { "type": "string", "minLength": 1 },
    "rawValue": { "type": "string" },
    "normalizedValue": { "type": "string" },
    "matchKey": { "type": "string" },
    "locale": { "enum": ["zh-Hans", "zh-Hant", "en", "ja", "ko"] },
    "status": { "enum": ["unknown", "review", "conflict", "confirmed"] },
    "reason": { "type": "string", "minLength": 1 },
    "selected": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/candidate" }] },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "coreCode", "display", "confidence", "qrEligible", "knowledgeOnly", "automaticResolution"],
      "properties": {
        "canonicalId": { "type": "string", "minLength": 1 },
        "coreCode": { "type": ["string", "null"] },
        "display": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "qrEligible": { "type": "boolean" },
        "knowledgeOnly": { "type": "boolean" },
        "automaticResolution": { "enum": ["allowed", "review", "blocked"] }
      }
    }
  }
}
