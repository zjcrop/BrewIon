{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brewion:foundation:recognition-document:1.1",
  "title": "Coffee Foundation RecognitionDocument 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parserVersion", "engine", "createdAt", "images", "blocks", "fullText"],
  "properties": {
    "schemaVersion": { "const": "recognition-document/1.1" },
    "parserVersion": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "rawFullText": { "type": "string" },
    "fullText": { "type": "string" },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "roleLabel", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["front", "back", "side", "date", "text"] },
          "roleLabel": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "fileName": { "type": "string" },
          "nativeSource": { "type": "boolean" }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "imageId", "imageRole", "order", "text", "confidence", "polygon", "engine"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "imageId": { "type": "string", "minLength": 1 },
          "imageRole": { "enum": ["front", "back", "side", "date", "text"] },
          "order": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "rawText": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "polygon": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  }
                }
              }
            ]
          },
          "box": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["left", "right", "top", "bottom", "width", "height", "centerX", "centerY"],
                "properties": {
                  "left": { "type": "number" },
                  "right": { "type": "number" },
                  "top": { "type": "number" },
                  "bottom": { "type": "number" },
                  "width": { "type": "number", "minimum": 0 },
                  "height": { "type": "number", "minimum": 0 },
                  "centerX": { "type": "number" },
                  "centerY": { "type": "number" }
                }
              }
            ]
          },
          "fieldAnchor": { "type": ["string", "null"] },
          "fieldAnchorConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "engine": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field"],
        "properties": {
          "id": { "type": "string" },
          "field": { "type": "string", "minLength": 1 },
          "imageId": { "type": "string" },
          "imageRole": { "enum": ["front", "back", "side", "date", "text"] },
          "labelBlockId": { "type": ["string", "null"] },
          "valueBlockId": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "value": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "method": { "type": "string" },
          "mode": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
