{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brewion:foundation:coffee-canonical-record:1.0",
  "title": "Coffee Foundation Canonical Coffee Record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "countryCode", "regionCode", "entityCode", "varietyCode", "processCode", "roastCode", "altitude", "roastDate", "flavorTags", "cropSeason", "evidence", "review"],
  "properties": {
    "schemaVersion": { "const": "coffee-canonical-record/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "countryCode": { "type": ["string", "null"] },
    "regionCode": { "type": ["string", "null"] },
    "entityCode": { "type": ["string", "null"] },
    "varietyCode": { "type": ["string", "null"] },
    "processCode": { "type": ["string", "null"] },
    "roastCode": { "type": ["string", "null"] },
    "roastColor": { "type": ["number", "string", "null"] },
    "altitude": {
      "oneOf": [
        { "type": "null" },
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "unit"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "unit": { "const": "m" }
          }
        }
      ]
    },
    "roastDate": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    },
    "flavorTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cropSeason": { "type": ["string", "null"] },
    "display": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceType", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceType": { "enum": ["ocr", "text", "qr", "manual", "dictionary", "ai", "import"] },
          "sourceRef": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "status", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "status": { "enum": ["unknown", "review", "conflict", "confirmed"] },
          "reason": { "type": "string" },
          "candidate": {}
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
