{
  "_format": "coffee-foundation-manifest",
  "_schemaVersion": 1,
  "provider": "brewion",
  "contract": "coffee-foundation/1.0",
  "status": "stable",
  "authority": {
    "repository": "zjcrop/BrewIon",
    "refPolicy": "immutable-commit",
    "manifest": "foundation/foundation-manifest.json",
    "releaseManifest": "foundation/releases/coffee-foundation-1.0.2.json"
  },
  "contracts": {
    "recognitionDocument": {
      "contract": "recognition-document/1.1",
      "schema": "schemas/recognition-document-v1.1.schema.json"
    },
    "canonicalCoffeeRecord": {
      "contract": "coffee-canonical-record/1.0",
      "schema": "schemas/coffee-canonical-record-v1.schema.json"
    },
    "aiEnrichmentResult": {
      "contract": "ai-enrichment-result/1.0",
      "schema": "schemas/ai-enrichment-result-v1.schema.json"
    },
    "recognitionBook": {
      "contract": "recognition-book/1.0",
      "schema": "schemas/recognition-book-v1.schema.json"
    },
    "fieldDecision": {
      "contract": "coffee-field-decision/1.0",
      "schema": "schemas/coffee-field-decision-v1.schema.json"
    },
    "foundationCandidate": {
      "contract": "coffee-foundation-candidate/1.0",
      "schema": "schemas/foundation-candidate-v1.schema.json"
    },
    "syncRevision": {
      "contract": "coffee-sync-revision/1.0",
      "schema": "schemas/sync-revision-v1.schema.json"
    },
    "archive": {
      "contract": "coffee-archive/1.0",
      "schema": "schemas/coffee-archive-v1.schema.json"
    },
    "migrationResult": {
      "contract": "coffee-migration-result/1.0",
      "schema": "schemas/migration-result-v1.schema.json"
    },
    "codebookProvider": {
      "contract": "coffee-codebook/1.0",
      "manifest": "../provider/releases/latest.json",
      "registry": "../provider/registry-entry.json"
    },
    "coffeeKnowledge": {
      "contract": "coffee-knowledge/1.0",
      "manifest": "../coffee-knowledge/releases/latest.json"
    }
  },
  "locales": {
    "preferred": ["zh-Hans", "en"],
    "supported": ["zh-Hans", "zh-Hant", "en", "ja", "ko"]
  },
  "policies": {
    "stableId": "immutable",
    "indexedTables": "append-only",
    "existingMetadataCorrection": "corrections-only",
    "recognitionEvidence": "preserve-source-and-confidence",
    "lowConfidence": "review-only",
    "conflict": "review-only",
    "aiAuthority": "advisory-only-never-overwrite-fact",
    "localization": "candidate-may-extend-never-replace-official-name",
    "artifactIntegrity": "sha256-required",
    "activation": "stage-verify-atomic-activate",
    "sync": "coffee-sync-revision/1.0",
    "archive": "coffee-archive/1.0",
    "failure": "retain-last-known-good",
    "consumerCompatibility": "contract-major-must-match",
    "migration": "unknown-major-reject-no-partial-write",
    "paidExternalService": "forbidden",
    "aiAvailability": "optional-core-must-work-without-ai",
    "aiProviderPolicy": "consumer-configured-free-only"
  },
  "consumerRules": {
    "applicationToApplicationDependencyForbidden": true,
    "platformOcrAdaptersAllowed": true,
    "platformAdaptersMustEmitRecognitionDocument": true,
    "unknownValuesMustRemainUnknown": true,
    "modelPredictionMustNotMasqueradeAsHumanObservation": true,
    "consumerMustPinImmutableRelease": true,
    "consumerMustNotLoadMainOrLatestAtRuntime": true,
    "sameRevisionSameHashIsIdempotent": true,
    "sameRevisionDifferentHashIsConflict": true
  },
  "runtime": {
    "entry": "runtime/index.mjs",
    "normalization": "coffee-normalization/1.0",
    "activation": "stage-verify-atomic-activate",
    "dependencies": []
  }
}
